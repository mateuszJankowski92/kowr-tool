# Copy this file to .env.production on the deployment host.
# Use a URL-safe, randomly generated password and keep both values in sync.
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
DATABASE_URL=postgresql://kowr:replace-with-a-strong-url-safe-password@database:5432/kowr
PM2_DATABASE_URL=postgresql://kowr:replace-with-a-strong-url-safe-password@127.0.0.1:5433/kowr

# Optional. Without these credentials, satellite statistics and imagery remain explicitly partial.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
